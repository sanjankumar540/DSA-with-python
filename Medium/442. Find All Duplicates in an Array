class Solution:
    def findDuplicates(self, nums: list[int]) -> list[int]:
        h = set()
        ans = []
        for i in nums:
            if i in h:
                ans.append(i)
            else:
                h.add(i)
        return ans


# same question using hashmap
class Solution:
    def findDuplicates(self, nums: list[int]) -> list[int]:
         h = {}
         ans = []
         for i in nums:
            if i in h.keys():
                ans.append(i)
            else:
                h[i]=1
         return ans